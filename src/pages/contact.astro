---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/site';
import { getContactRows } from '../lib/contact';

const contactRows = getContactRows(profile);
---

<BaseLayout
  title="Contact"
  description={`Neem contact op met ${profile.name}.`}
>
  <!-- Page header -->
  <section class="page-head">
    <div class="container">
      <p class="mono-label">
        <span class="index">05</span>Contact
      </p>
      <h1 class="serif-display page-title">
        Laten we
        <br />
        kennismaken.
      </h1>
      <p class="lede page-lede">
        Een nieuwe opdracht, een design system-vraagstuk of gewoon een goed
        gesprek over frontend architectuur — mijn inbox staat open.
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section class="section contact-section">
    <div class="container contact-grid">
      <div class="contact-main">
        <p class="contact-intro">
          Momenteel beschikbaar voor een nieuwe opdracht — hybride of volledig
          op afstand, in de regio Limburg / Hasselt en daarbuiten. Wil je weten
          of ik bij je team pas? Stuur een bericht — ik reageer snel.
        </p>
        <a class="btn btn-accent contact-cta" href={`mailto:${profile.email}`}>
          Stuur een e-mail{' '}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>

      <dl class="contact-list">
        {contactRows.map((row) => (
          <div class="contact-row">
            <dt class="mono-label contact-label">{row.label}</dt>
            {row.href ? (
              <dd class="contact-value">
                <a
                  href={row.href}
                  target={
                    row.href.startsWith('mailto') || row.href.startsWith('tel')
                      ? undefined
                      : '_blank'
                  }
                  rel={row.href.startsWith('http') ? 'noopener' : undefined}
                >
                  {row.value}
                </a>
              </dd>
            ) : (
              <dd class="contact-value">{row.value}</dd>
            )}
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(5rem, 12vw, 9rem);
    border-bottom: 1px solid var(--line);
  }

  .page-title {
    font-size: clamp(2.6rem, 7vw, 5.5rem);
    color: var(--text-strong);
    margin: 1.25rem 0 1.75rem;
  }

  .page-lede {
    max-width: 46rem;
  }

  .contact-section {
    border-bottom: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 7rem);
  }

  .contact-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;
  }

  .contact-intro {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    line-height: 1.45;
    color: var(--text-strong);
    max-width: 34rem;
  }

  .contact-list {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .contact-row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .contact-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .contact-label {
    color: var(--dim);
    padding-top: 0.1rem;
  }

  .contact-value {
    margin: 0;
    font-size: 1.05rem;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .contact-value a {
    position: relative;
    display: inline-block;
  }

  .contact-value a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--line-strong);
    transition: background 0.2s ease;
  }

  .contact-value a:hover {
    color: var(--accent);
  }

  .contact-value a:hover::after {
    background: var(--accent);
  }

  @media (max-width: 46rem) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }
</style>
